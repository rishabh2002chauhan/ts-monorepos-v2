{
	"$schema": "./node_modules/nx/schemas/nx-schema.json",
	"targetDefaults": {
		"test": { "dependsOn": ["^test", "^build"], "cache": true },
		"test:coverage": { "outputs": ["{projectRoot}/coverage"], "cache": true },
		"build": { "outputs": ["{projectRoot}/dist"], "cache": true },
		"lint": { "cache": true },
		"check": { "cache": true },
		"format": { "cache": true }
	},
	"analytics": true,
	"plugins": [
		{ "plugin": "@nx/eslint/plugin", "options": { "targetName": "eslint:lint" } },
		{
			"plugin": "@nx/vitest",
			"options": {
				"testTargetName": "vitest:test",
				"ciTargetName": "test-ci",
				"testMode": "watch"
			}
		},
		{
			"plugin": "@nx/vite/plugin",
			"options": {
				"buildTargetName": "vite:build",
				"testTargetName": "vite:test",
				"serveTargetName": "serve",
				"devTargetName": "vite:dev",
				"previewTargetName": "vite:preview",
				"serveStaticTargetName": "serve-static",
				"typecheckTargetName": "typecheck",
				"buildDepsTargetName": "build-deps",
				"watchDepsTargetName": "watch-deps"
			}
		}
	],
	"nxCloudId": "69cc10b1a60c532762771755"
}
